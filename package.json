{
  "name": "react-scroll-detect",
  "version": "2.0.0",
  "description": "Tiny React components that tell you which section is in the viewport as the user scrolls.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "keywords": [
    "react",
    "scroll",
    "scroll detect",
    "scrollspy",
    "react scroll",
    "intersection",
    "viewport"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --target es2018",
    "test": "vitest run --environment jsdom",
    "test:watch": "vitest --environment jsdom",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g30elipse/react-scroll-detect.git"
  },
  "homepage": "https://github.com/g30elipse/react-scroll-detect#readme",
  "bugs": {
    "url": "https://github.com/g30elipse/react-scroll-detect/issues"
  },
  "author": "Mukut Brahma",
  "license": "ISC",
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
